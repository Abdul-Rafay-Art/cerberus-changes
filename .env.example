APP_NAME=Cerberus
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_TIMEZONE=Europe/London

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=SET_IN_CYBERPANEL
DB_USERNAME=SET_IN_CYBERPANEL
DB_PASSWORD=SET_IN_CYBERPANEL

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=SET_IN_CYBERPANEL
MAIL_PORT=587
MAIL_USERNAME=SET_IN_CYBERPANEL
MAIL_PASSWORD=SET_IN_CYBERPANEL
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=SET_APPROVED_SENDER
MAIL_FROM_NAME="${APP_NAME}"
